# Fabiano Reis Imóveis — ambiente de configuração
# NUNCA coloque valores reais neste arquivo de exemplo.

NODE_ENV=production
PORT=3000

# PostgreSQL/Neon — obrigatório em produção
DATABASE_URL=

# JWT — obrigatório em produção; use um segredo longo e aleatório
JWT_SECRET=

# URL pública do site
SITE_URL=https://fabianoreisimoveis.com.br

# Origem permitida para CORS
CORS_ORIGIN=https://fabianoreisimoveis.com.br

# Proxy reverso da Hostinger
TRUST_PROXY=1

# Armazenamento de mídia
STORAGE_PROVIDER=local
MEDIA_ROOT=/home/SEU_USUARIO/domains/fabianoreisimoveis.com.br/fabiano-reis-media

# E-mail/recuperação de senha (se utilizado em produção)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
CONTATO_EMAIL=

# Criação inicial do administrador — usar apenas no comando admin:create
ADMIN_NAME=Fabiano Reis
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SQLite é apenas para desenvolvimento/migração local.
# SQLITE_FILE=./database.db

# SMOKE TEST local
# SMOKE_PORT=3199
