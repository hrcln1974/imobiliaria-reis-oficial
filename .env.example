# Copie para .env e preencha. NUNCA versione o .env.

# Porta local (padrão 3000)
PORT=3000

# Segredo do JWT — obrigatório em produção (use um valor longo e aleatório)
JWT_SECRET=

# Banco de dados
# Vazio = SQLite local (database.db). Preenchido = PostgreSQL/Neon.
DATABASE_URL=

# Domínio público autorizado no CORS (ex.: https://seudominio.com.br)
CORS_ORIGIN=

# Armazenamento de mídia
# Hostinger/Node tradicional: deixe vazio para usar MEDIA_ROOT persistente
# Vercel: configure BLOB_READ_WRITE_TOKEN para usar Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Usado apenas pelo comando: npm run admin:create
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Fabiano Reis

# Hostinger: pasta persistente para fotos e vídeos, fora do diretório de deploy.
# Exemplo: /home/SEU_USUARIO/fabiano-reis-media
MEDIA_ROOT=

# Produção atrás de proxy/reverse proxy (Hostinger):
TRUST_PROXY=1
# SQLite local/testes (opcional):
SQLITE_DB_PATH=
# Domínio público oficial:
PUBLIC_SITE_URL=https://fabianoreisimoveis.com.br
