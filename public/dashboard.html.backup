<!-- MODAL DE DETALHE DO LEAD -->
<div id="modalLead" class="modal">
  <div class="modal-content lead-modal-content">
    <span class="close" onclick="fecharModalLead()">&times;</span>
    <h2>👤 Detalhes do Lead</h2>
    <div id="detalheLead"></div>
  </div>
</div>

<!-- MODAL DE IMAGENS -->
<div id="modalImagens" class="modal">
  <div class="modal-content">
    <span class="close" onclick="fecharModalImagens()">&times;</span>
    <h2>📷 Gerenciar Mídias do Imóvel</h2>
    <div id="infoImovelImagens" style="background: linear-gradient(135deg, #dbeafe 0%, #f0f9ff 100%); padding: 16px; border-radius: 10px; margin-bottom: 20px; border-left: 4px solid #3b82f6;"></div>
    
    <h3 style="margin: 24px 0 16px 0; font-weight: 700; color: #1f2937;">📸 Fotos cadastradas</h3>
    <div id="listaImagens" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 12px; margin-bottom: 28px;"></div>

    <div style="border-top: 2px solid #e2e8f0; padding-top: 24px;">
      <h3 style="margin: 0 0 16px 0; font-weight: 700; color: #1f2937;">Adicionar Fotos</h3>
      <div class="form-group">
        <label>Fotos do computador</label>
        <input type="file" id="fotosModal" accept="image/jpeg,image/png,image/webp,image/gif" multiple>
        <small style="display:block;margin-top:7px;color:#64748b;">Até 12 fotos, 5 MB por foto.</small>
      </div>
      <button onclick="enviarFotosModal()" class="btn btn-primary" style="width: 100%;">📤 Enviar Fotos</button>

      <div class="form-group" style="margin-top:18px;">
        <label>Ou adicionar por URL</label>
        <input type="text" id="urlNovaImagem" placeholder="https://exemplo.com/imagem.jpg">
      </div>
      <button onclick="adicionarImagem()" class="btn btn-secondary" style="width: 100%;">🔗 Adicionar por URL</button>
    </div>

    <div style="border-top: 2px solid #e2e8f0; padding-top: 24px; margin-top: 24px;">
      <h3 style="margin: 0 0 8px 0; font-weight: 700; color: #1f2937;">🎬 Vídeos do imóvel</h3>
      <p style="margin:0 0 16px;color:#64748b;font-size:13px;">Adicione um tour em vídeo. Aceita MP4, WebM ou MOV (até 50 MB por vídeo).</p>
      <div id="listaVideos" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-bottom:18px;"></div>

      <div class="form-group">
        <label>Vídeos do computador</label>
        <input type="file" id="videosModal" accept="video/mp4,video/webm,video/ogg,video/quicktime" multiple>
        <small style="display:block;margin-top:7px;color:#64748b;">Até 3 vídeos por envio • 50 MB por vídeo.</small>
      </div>
      <button onclick="enviarVideosModal()" class="btn btn-primary" style="width:100%;">🎬 Enviar Vídeos</button>

      <div class="form-group" style="margin-top:18px;">
        <label>Ou adicionar vídeo por URL</label>
        <input type="url" id="urlNovoVideo" placeholder="https://... (MP4, YouTube ou Vimeo)">
      </div>
      <button onclick="adicionarVideoUrl()" class="btn btn-secondary" style="width:100%;">🔗 Adicionar Vídeo por URL</button>
    </div>

    <div id="msgImagens" class="form-message"></div>
  </div>
</div>

<script src="dashboard.js"></script>

</body>
</html>
