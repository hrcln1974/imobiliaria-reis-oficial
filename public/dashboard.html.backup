      <!-- LEADS -->
      <section id="leads" class="section">
        <div class="section-heading-row">
          <div>
            <div class="section-title" style="margin-bottom:6px;">💬 Gerenciador de Leads</div>
            <p class="section-subtitle">Acompanhe contatos, interesse e próximos atendimentos.</p>
          </div>
          <button class="btn btn-light btn-compact" onclick="carregarLeads()">↻ Atualizar</button>
        </div>

        <div class="panel-toolbar leads-toolbar">
          <div class="toolbar-stat"><strong id="leadsVisiveis">0</strong><span>leads</span></div>
          <div class="toolbar-search">
            <span>⌕</span><input id="buscaLead" type="search" placeholder="Buscar nome, telefone ou e-mail..." oninput="filtrarLeadsPainel()">
          </div>
          <label class="toolbar-select-label">Status
          <select id="filtroStatus" onchange="carregarLeads()">
            <option value="">Todos</option>
            <option value="novo">Novo</option>
            <option value="contato">Em Contato</option>
            <option value="interessado">Interessado</option>
            <option value="convertido">Convertido</option>
          </select>
          </label>
        </div>

        <div class="table-responsive">
          <table class="tabela">
            <thead>
              <tr>
                <th>Contato</th><th>Telefone</th><th>Interesse</th><th>Status</th><th>Data</th><th>Ações</th>
              </tr>
            </thead>
            <tbody id="tabelaLeads">
              <tr><td colspan="6" style="text-align: center; padding: 30px;">Carregando...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- PERFIL -->
      <section id="perfil" class="section">
        <div class="section-title">👤 Meu Perfil</div>

        <div class="form-section" style="max-width: 800px;">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">
            <div style="border-bottom: 2px solid #cbd5e1; padding-bottom: 16px;">
              <div style="font-weight: 700; color: #64748b; margin-bottom: 8px;">Nome</div>
              <div style="font-size: 16px; color: #1f2937;">Fabiano Reis de Araújo</div>
            </div>
            <div style="border-bottom: 2px solid #cbd5e1; padding-bottom: 16px;">
