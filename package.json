{
  "name": "fabiano-reis-imoveis",
  "version": "12.1.5",
  "description": "Plataforma imobiliária Fabiano Reis — produção Hostinger, CRM, WhatsApp, catálogo, mídia e agenda.",
  "main": "server.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node preflight.js",
    "test:smoke": "node scripts/smoke-test.js",
    "build:release": "node scripts/build-release.js",
    "admin:create": "node scripts/create-admin.js",
    "start:prod": "NODE_ENV=production node server.js",
    "check:syntax": "node --check server.js && node --check db-adapter.js && node --check storage/index.js",
    "verify": "npm run check && npm run check:syntax && npm run check:crm",
    "check:crm": "node --check public/crm.js && node --check server.js",
    "migrate:postgres": "node scripts/migrate-sqlite-to-postgres.js"
  },
  "keywords": [
    "imobiliária",
    "corretor",
    "imóveis",
    "venda",
    "aluguel"
  ],
  "author": "Fabiano Reis",
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-static-gzip": "^2.1.8",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.7"
  }
}
