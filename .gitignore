# Segredos e ambiente
.env
.env.*
!.env.example

# Dependências e build
node_modules/
release/
*.tgz

# Banco local de desenvolvimento (nunca versionar dados)
database.db
database.db-wal
database.db-shm
*.sqlite
*.sqlite3

# Backups e dumps (contêm dados reais de clientes)
backups/
*.dump
*.sql.gz

# Mídia enviada pelo corretor (fica no storage persistente, não no Git)
public/uploads/imagens/*
public/uploads/videos/*
!public/uploads/README.txt
!public/uploads/imagens/.gitkeep
!public/uploads/videos/.gitkeep

# Logs e temporários
logs/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vercel

*.db
coverage/